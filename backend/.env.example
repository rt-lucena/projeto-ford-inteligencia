# backend/.env.example
# Copie este arquivo para .env e preencha com suas chaves reais

# Chave secreta para JWT (use uma string aleatória)
JWT_SECRET_KEY=sua_chave_secreta_aqui

# YouTube OAuth (se for usar)
YOUTUBE_CLIENT_ID=seu_client_id
YOUTUBE_CLIENT_SECRET=seu_client_secret
YOUTUBE_PROJECT_ID=seu_project_id
